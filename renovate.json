{
  "extends": ["config:base", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "depTypeList": ["devDependencies"],
      "automerge": true
    },
    {
      "updateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "minimumReleaseAge": "1 day",
  "automergeType": "branch",
  "labels": ["renovate"],
  "semanticCommits": "enabled"
}
