{
  "extends": ["config:base", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "depTypeList": ["devDependencies"],
      "automerge": true
    },
    {
      "updateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "typescript-eslint does not support TypeScript 6.1+ yet",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "our own package, no reason to wait for it",
      "matchPackageNames": ["@tf2pickup-org/mumble-protocol"],
      "minimumReleaseAge": null
    }
  ],
  "minimumReleaseAge": "1 day",
  "automergeType": "branch",
  "labels": ["renovate"],
  "semanticCommits": "enabled"
}
